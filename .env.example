# Environment Variables for Semantic Image Search

# OpenAI API Key (required for query translation)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Configuration (required)
QDRANT_URL=https://your-cluster-url.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=semantic_images

# Optional: Logging Level
LOG_LEVEL=INFO

# Optional: Backend Port (default: 8000)
BACKEND_PORT=8000

# Optional: Frontend Port (default: 19002 for Expo web)
FRONTEND_PORT=19002
